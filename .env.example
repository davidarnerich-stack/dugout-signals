# Copy to .env and fill in. .env is gitignored and never leaves your machine.
#
# The first three are not secret — they are already in render.yaml.
SUPABASE_URL=https://bqjbswbxtyapupufoarv.supabase.co
SUPABASE_ANON_KEY=
SITE_URL=https://app.dugoutsignals.ai

# Signs local session cookies only. Any random string; need not match Render.
#   python3 -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=

# Secret. Render dashboard -> dugout-signals -> Environment.
SUPABASE_KEY=

# Secret. Only needed to generate a real report locally; the test harness
# stubs every model call, so tests run without it.
ANTHROPIC_API_KEY=
