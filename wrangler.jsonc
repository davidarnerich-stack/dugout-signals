{
  // Cloudflare Workers static-asset config for the marketing site
  // (dugoutsignals.ai). Lives in git on purpose: with Workers Builds, the
  // "what do I publish" decision belongs in a versioned file rather than a
  // dashboard field nobody can review. The dashboard only needs the build
  // command; everything else is here.
  //
  // The app (Flask on Render) ignores this file entirely.
  "name": "polished-hall-6f6b",
  // Cloudflare auto-generated this name when the Worker was created, and a
  // Worker's name is its identity — deploying under any other name would
  // target a different Worker than the dashboard is wired to. Cosmetic only:
  // once dugoutsignals.ai fronts it, the name is never public. If it gets
  // renamed in the dashboard, change it here in the same sitting.
  "compatibility_date": "2026-08-24",

  // No "main" script — this is a pure static site, so Workers serves the
  // directory directly. `directory` is the equivalent of what Cloudflare
  // Pages called "Build output directory".
  "assets": {
    "directory": "./marketing"
  }
}
